# Copy this file to .env and set the PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/patrick
# Alternatively, configure the connection from separate variables:
# DATABASE_USER=postgres
# DATABASE_PASSWORD=change-me
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=patrick
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APP_ENV=development
GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=replace-with-gitlab-oauth-client-id
GITLAB_CLIENT_SECRET=replace-with-gitlab-oauth-client-secret
GITLAB_REDIRECT_URI=http://localhost:8000/api/auth/gitlab/callback
ADMIN_GITLAB_ID=40094048
SESSION_SECRET=replace-with-a-long-random-secret

# Production example:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://patrick:change-me@postgresql:5432/patrick
# CORS_ORIGINS=["https://your-frontend.example.com"]
# GITLAB_REDIRECT_URI=https://your-api.example.com/api/auth/gitlab/callback
